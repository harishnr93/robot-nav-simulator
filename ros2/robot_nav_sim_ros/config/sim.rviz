Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Inflated map (planner)
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /inflated_map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Color: 31; 119; 180
      Line Style: Billboards
      Line Width: 0.06
      Alpha: 1
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Color: 123; 45; 158
      Line Style: Billboards
      Line Width: 0.04
      Alpha: 1
      Topic:
        Value: /trajectory
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Robot (odometry)
      Enabled: true
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 127; 14
        Alpha: 1
        Shaft Length: 0.4
        Shaft Radius: 0.06
        Head Length: 0.2
        Head Radius: 0.12
      Covariance:
        Value: false
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Style: Flat Squares
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 42; 157; 143
      Alpha: 1
      Decay Time: 0
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF estimate
      Enabled: true
      Shape: Arrow
      Color: 42; 157; 143
      Covariance:
        Value: true
        Position:
          Value: true
          Scale: 3
        Orientation:
          Value: true
          Scale: 3
      Topic:
        Value: /ekf/pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: Dead reckoning
      Enabled: true
      Shape: Arrow
      Color: 138; 138; 138
      Topic:
        Value: /ekf/dead_reckoning
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Moving obstacles
      Enabled: true
      Namespaces:
        dynamic_obstacles: true
      Topic:
        Value: /dynamic_obstacles
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.6
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.07
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 70
      X: 5
      Y: 5
      Angle: 0
      Enable Stereo Rendering:
        Value: false
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
